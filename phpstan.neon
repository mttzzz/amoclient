includes:
    - vendor/larastan/larastan/extension.neon

    # РАСКОММЕНТИРОВАТЬ ОДНОВРЕМЕННО С `composer update` — раньше нельзя.
    #
    # Расширение учит phpstan сужать типы по ассертам PHPUnit: без него
    # assertIsArray()/assertNotNull() для анализатора — обычные вызовы, и каждый
    # типизируемый тест платит за это ручным гардом рядом с уже написанной
    # проверкой. Пакет добавлен в composer.json этим же коммитом.
    #
    # Строка закомментирована, потому что vendor пересобирает лид в финале, а
    # phpstan падает на отсутствующем include ещё до анализа — то есть у всех,
    # кто запустит `composer stan` в этом промежутке, он сломается на конфиге.
    # Опционального include («?path») этот phpstan не поддерживает: путь берётся
    # буквально, проверено.
    # - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
  level: max
  # Страховочная сетка живёт в tests/, поэтому анализ только по src оставлял
  # без типов ровно тот код, который защищает боевой аккаунт от сноса лишнего:
  # ошибку в нём не поймал бы ни один инструмент.
  #
  # Легаси-сьют (tests/*Test.php) сюда НЕ включён намеренно: на level max он
  # даёт больше тысячи ошибок, это отдельная кампания, а не SP0. Добавлять его
  # по одному файлу можно и нужно — по мере того, как файлы приводятся в порядок.
  paths:
      - src
      - tests/Support
      - tests/Resilience
      - tests/BaseAmoClient.php
      - tests/BaseAmoClientTest.php
