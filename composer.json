{
    "name": "mttzzz/amoclient",
    "description": "AmoClient",
    "license": "MIT",
    "authors": [
        {
            "name": "pushka.biz",
            "email": "info@pushka.biz",
            "homepage": "https://pushka.biz"
        }
    ],
    "homepage": "https://github.com/mttzzz/amoclient",
    "keywords": [
        "Laravel",
        "AmoClient"
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "mttzzz/laravel-telegram-log": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "guzzlehttp/guzzle": "^7.11",
        "illuminate/http": "^13.14",
        "orchestra/testbench": "^11.1",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "mttzzz\\AmoClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "mttzzz\\AmoClient\\Tests\\": "tests"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "mttzzz\\AmoClient\\AmoClientServiceProvider"
            ],
            "aliases": {
                "AmoClient": "mttzzz\\AmoClient\\Facades\\AmoClient"
            }
        }
    }
}
